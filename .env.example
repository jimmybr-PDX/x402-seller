# Required for CDP Facilitator auth (verify + settle). Get keys at https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional: receive payments at your own EVM address (Base Sepolia / Base).
# If set → createX402Server({ payToConfig: { type: "address", evm: X402_PAY_TO } })
# If unset → omit payToConfig so CDP provisions an API Key Wallet (requires CDP_WALLET_SECRET)
X402_PAY_TO=

# Only needed when X402_PAY_TO is unset (CDP wallet provisioning path)
CDP_WALLET_SECRET=

# Server
PORT=8402
# development = Base Sepolia (eip155:84532), test funds
# production  = Base mainnet (eip155:8453), real funds
X402_ENV=development

# Price for GET /report. Defaults: $0.01 (development), $1.25 (production)
# REPORT_PRICE=$0.01

# Guard rails
DAILY_SPEND_CAP_USD=50

# Optional LLM for report body (synthetic outline used if both absent)
# OPENAI_API_KEY=
# GROK_API_KEY=
# GROK_API_BASE=https://api.x.ai/v1
