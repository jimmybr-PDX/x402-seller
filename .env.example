# Required for CDP Facilitator auth (verify + settle). Get keys at https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Receive payments at your own EVM address. If unset, CDP provisions a wallet (needs CDP_WALLET_SECRET).
X402_PAY_TO=
CDP_WALLET_SECRET=

PORT=8402
# development = Base Sepolia (eip155:84532), production = Base + Polygon + Arbitrum mainnet
X402_ENV=development
# Optional override (comma-separated CAIP-2): eip155:8453,eip155:137,eip155:42161
# X402_NETWORKS=
PUBLIC_URL=https://x402-seller-pmlm.onrender.com

# Per-call prices (USD, paid in USDC)
REPORT_PRICE=$0.01
READ_PRICE=$0.005
CHECK_PRICE=$0.005

# Runaway guard on confirmed settlements per UTC day
DAILY_SPEND_CAP_USD=50

# Optional LLM synthesis for /report (extractive cited brief if absent or failing)
# GROK_API_KEY=
# GROK_MODEL=grok-4.3
# OPENAI_API_KEY=
