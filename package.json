{
  "name": "x402-seller",
  "version": "1.0.0",
  "private": true,
  "description": "Agent Research Tools: pay-per-call x402 APIs (cited research brief, URL to markdown, news search, web search with page text, onchain token price incl. Solana, wallet balance, transaction lookup, gas price, x402 endpoint check), USDC on Base, Polygon, Arbitrum, Solana, Avalanche or Sei",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "tsx src/server.ts",
    "report-week": "tsx scripts/report-week.ts",
    "rank-check": "node scripts/rank-check.mjs",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@coinbase/cdp-sdk": "^1.55.0",
    "@solana/kit": "^5.5.1",
    "@x402/core": "^2.0.0",
    "@x402/evm": "^2.0.0",
    "@x402/express": "^2.0.0",
    "@x402/extensions": "^2.0.0",
    "@x402/fetch": "^2.25.0",
    "@x402/svm": "^2.0.0",
    "express": "^5.1.0",
    "viem": "^2.56.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "keywords": [
    "x402",
    "x402-bazaar",
    "ai-agents",
    "research",
    "web-scraping",
    "markdown",
    "news-search",
    "token-price",
    "solana-token-price",
    "wallet-balance",
    "transaction-lookup",
    "gas-price",
    "usdc",
    "base",
    "polygon",
    "arbitrum",
    "solana",
    "avalanche",
    "sei"
  ]
}
